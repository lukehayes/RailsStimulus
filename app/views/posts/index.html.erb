<p style="color: green"><%= notice %></p>

<div data-controller="custom">
    <input type="text" data-custom-target="name">
    <button data-action="click->custom#foo">Foo Button</button>
</div>

<% content_for :title, "Posts" %>

<h1 class='display:block'>Posts</h1>

<div id="posts" class='pt-8'>
  <% @posts.each do |post| %>
    <%= render post %>
    <p>
    <%= link_to "Show this post", post, class: 'bg-slate-300 p-2 rounded my-24'%>
    </p>
  <% end %>
</div>

<%= link_to "New post", new_post_path %>

