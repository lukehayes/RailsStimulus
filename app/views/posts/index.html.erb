<p style="color: green"><%= notice %></p>


<div data-controller="clipboard" class='mb-24'>
  PIN: <input data-clipboard-target="source" type="text" value="1234" id="" readonly class='block'/>
  <button data-action="clipboard#copy" class='bg-slate-400 p-2 my-4 hover:bg-slate-300'>Copy To Clipboard</button>
</div>

<div data-controller="custom">
    <input type="text" data-custom-target="name">
    <button data-action="click->custom#foo">Foo Button</button>
</div>

<% content_for :title, "Posts" %>

<h1 class='display:block'>Posts</h1>

<div id="posts" class='block '>
  <% @posts.each do |post| %>
    <%= render post %>
    <p>
    <%= link_to "Show this post", post, class: 'bg-rose-700 rounded mt-4 p-3 text-white'%>
    </p>
  <% end %>
</div>

<%= link_to "New post", new_post_path %>

